{
	"_version": "1.59.0",
	"sap.app": {
		"id": "vagoes.dashboard",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [""],
			"fallbackLocale": ""
		},
		"applicationVersion": {
			"version": "0.1.0"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"crossNavigation": {
			"inbounds": {
				"vagoes-display": {
					"semanticObject": "Vagao",
					"action": "display",
					"title": "{{appTitle}}",
					"subTitle": "{{appDescription}}",
					"icon": "sap-icon://shipping-status",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		},
		"dataSources": {
			"mockData": {
				"uri": "model/mockData.json",
				"type": "JSON"
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "sap-icon://shipping-status"
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": false,
		"dependencies": {
			"minUI5Version": "1.120.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.f": {},
				"sap.ui.layout": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "vagoes.dashboard.i18n.i18n",
					"supportedLocales": [""],
					"fallbackLocale": ""
				}
			},
			"mock": {
				"type": "sap.ui.model.json.JSONModel",
				"dataSource": "mockData"
			}
		},
		"resources": {
			"css": [
				{ "uri": "css/style.css" }
			]
		},
		"rootView": {
			"viewName": "vagoes.dashboard.view.Main",
			"type": "XML",
			"id": "main",
			"async": true
		}
	}
}
