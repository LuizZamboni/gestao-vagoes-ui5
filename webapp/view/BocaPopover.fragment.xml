<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">
	<!--
		Popover de uma boca (abre ao tocar em um silo na estação 3D).
		Mostra os dados da boca selecionada (/bocaSelecionada, montado em
		model/ModeloTela.js) e permite ligar/desligar e ajustar a comporta.
		O modelo é somente leitura: o Slider avisa o controller (liveChange),
		que grava no estado e republica a tela.
	-->
	<ResponsivePopover
		id="bocaPopover"
		title="{/bocaSelecionada/titulo}"
		placement="Auto"
		contentWidth="22rem"
		class="vgBocaPop">
		<content>
			<VBox class="sapUiSmallMargin">
				<FlexBox justifyContent="SpaceBetween" alignItems="Center">
					<ObjectStatus
						text="{/bocaSelecionada/statusTexto}"
						state="{/bocaSelecionada/statusEstado}"
						icon="{/bocaSelecionada/statusIcone}"
						inverted="true"/>
					<ObjectNumber
						number="{/bocaSelecionada/vazaoTexto}"
						unit="t/h"
						emphasized="true"
						state="{= ${/bocaSelecionada/fluindo} ? 'Information' : 'None' }"/>
				</FlexBox>

				<MessageStrip
					text="{/bocaSelecionada/alertaTexto}"
					type="{/bocaSelecionada/alertaTipo}"
					visible="{/bocaSelecionada/temAlerta}"
					showIcon="true"
					class="sapUiSmallMarginTop"/>

				<form:SimpleForm editable="false" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1" class="vgForm">
					<Label text="{i18n>pop.material}"/>
					<Text text="{/bocaSelecionada/produto}"/>
					<Label text="{i18n>pop.receita}"/>
					<Text text="{/bocaSelecionada/receitaCodigo}"/>
					<Label text="{i18n>pop.nominal}"/>
					<Text text="{/bocaSelecionada/vazaoNominalTexto}"/>
					<Label text="{i18n>pop.destino}"/>
					<Text text="{/bocaSelecionada/destinoTexto}"/>
					<Label text="{i18n>pop.umidade}"/>
					<Text text="{/bocaSelecionada/umidadeTexto}"/>
				</form:SimpleForm>

				<Label text="{i18n>pop.nivel}" class="sapUiTinyMarginTop"/>
				<ProgressIndicator
					percentValue="{/bocaSelecionada/nivelPct}"
					displayValue="{/bocaSelecionada/nivelTexto}"
					state="{/bocaSelecionada/nivelEstado}"/>

				<Label text="{/bocaSelecionada/aberturaRotulo}" labelFor="sldAbertura" class="sapUiSmallMarginTop"/>
				<Slider
					id="sldAbertura"
					value="{/bocaSelecionada/aberturaPct}"
					min="0"
					max="100"
					step="5"
					enableTickmarks="true"
					width="100%"
					liveChange=".onMudarAberturaDaBoca"/>
			</VBox>
		</content>
		<beginButton>
			<Button
				text="{/bocaSelecionada/textoAcao}"
				type="{/bocaSelecionada/tipoAcao}"
				icon="{/bocaSelecionada/iconeAcao}"
				press=".onLigarOuDesligarBoca"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>fechar}" press=".onFecharPopover"/>
		</endButton>
	</ResponsivePopover>
</core:FragmentDefinition>
